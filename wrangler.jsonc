{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alex-wenger-golf-edge",
  "main": "src/edge/worker.js",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  "r2_buckets": [
    {
      "binding": "SPATIAL_STORAGE",
      "bucket_name": "golf-spatial-engine-assets",
      "preview_bucket_name": "golf-spatial-engine-preview"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "USER_MEMORY",
      "id": "kv_user_memory_prod_id",
      "preview_id": "kv_user_memory_dev_id"
    },
    {
      "binding": "COURSE_INDEX",
      "id": "kv_course_index_prod_id",
      "preview_id": "kv_course_index_dev_id"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "API_VERSION": "v4.6.0",
    "MAX_PAYLOAD_SIZE_BYTES": 153600,
    "PATENT_GOVERNANCE": "WO/2026/150385"
  }
}
