{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alex-wenger-golf-engine",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PATENT_GOVERNANCE": "WO/2026/150385",
    "ENGINE_VERSION": "v4.3.0"
  }
}
